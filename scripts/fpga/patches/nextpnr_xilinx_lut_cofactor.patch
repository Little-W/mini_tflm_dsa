+// 余因子配对保持共同的 A1..A5 引脚，完整函数的选择变量单独使用 A6。
+static bool cofactor_lut_pair_valid(const Context *ctx, const CellInfo *lut6, const CellInfo *lut5)
+{
+    if (lut6 == nullptr || lut5 == nullptr)
+        return false;
+    IdString marker = ctx->id("X_LUT_COFACTOR_PAIR");
+    if (!lut6->attrs.count(marker) || !lut5->attrs.count(marker) ||
+        lut6->attrs.at(marker).as_string().empty() ||
+        lut6->attrs.at(marker).as_string() != lut5->attrs.at(marker).as_string())
+        return false;
+    if (lut6->lutInfo.is_memory || lut6->lutInfo.is_srl || lut5->lutInfo.is_memory || lut5->lutInfo.is_srl ||
+        lut6->lutInfo.output_count != 1 || lut5->lutInfo.output_count != 1)
+        return false;
+    if (get_net_or_empty(lut6, ctx->id("O6")) == nullptr || get_net_or_empty(lut5, ctx->id("O5")) == nullptr ||
+        get_net_or_empty(lut6, ctx->id("A6")) == nullptr || get_net_or_empty(lut5, ctx->id("A6")) != nullptr)
+        return false;
+    if (str_or_default(lut6->attrs, ctx->id("X_ORIG_TYPE")) != "LUT6" ||
+        str_or_default(lut5->attrs, ctx->id("X_ORIG_TYPE")) != "LUT5" ||
+        str_or_default(lut6->attrs, ctx->id("X_ORIG_PORT_A6")) != "I5")
+        return false;
+    for (int input = 1; input <= 5; input++) {
+        IdString pin = ctx->id("A" + std::to_string(input));
+        IdString origin = ctx->id("X_ORIG_PORT_A" + std::to_string(input));
+        if (get_net_or_empty(lut6, pin) != get_net_or_empty(lut5, pin) ||
+            str_or_default(lut6->attrs, origin) != str_or_default(lut5->attrs, origin))
+            return false;
+    }
+    IdString init = ctx->id("INIT");
+    if (!lut6->params.count(init) || !lut5->params.count(init))
+        return false;
+    return lut6->params.at(init).extract(0, 32).str == lut5->params.at(init).extract(0, 32).str;
+}
